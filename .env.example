# Existing .env is never overwritten. Keep credentials local.
# Choose one text-model configuration group.
CODEX_API_KEY=
CODEX_BASE_URL=
CODEX_MODEL=gpt-6.1-sol
USE_MOCK_LLM=false

# Music requires a separate service. Text models alone do not emit song audio.
# gateway uses the documented POST /generate + GET /tasks/{id} protocol.
MUSIC_PROVIDER=unconfigured
REAL_MUSIC_API_KEY=
REAL_MUSIC_BASE_URL=
ACEMUSIC_MODEL=acemusic/acestep-v1.5-turbo
FFMPEG_PATH=ffmpeg

# Native ACEMusic (separate from the generic gateway):
# MUSIC_PROVIDER=acemusic
# REAL_MUSIC_BASE_URL=https://api.acemusic.ai
# REAL_MUSIC_API_KEY=your_local_acemusic_key
# Uses /v1/models and /v1/chat/completions; credentials never belong in source.

# Explicit offline acceptance only:
# USE_MOCK_LLM=true
# MUSIC_PROVIDER=mock

BASE_STORAGE_DIR=storage/projects
PACKAGES_DIR=release-package
LYRICS_MAX_REVISIONS=2
MOCK_AUDIO_SAMPLE_DURATION=0
