# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Mock Settings & Resilience Testing
# Set to 'true' to force offline mock LLM engine (useful for automated tests and sandbox without internet)
USE_MOCK_LLM=false

# Mock Music Model Failure Injection (for testing resilience)
MOCK_AUDIO_DELAY_SECONDS=0.1
MOCK_AUDIO_SIMULATE_429=false
MOCK_AUDIO_SIMULATE_EMPTY=false
MOCK_AUDIO_SIMULATE_TIMEOUT=false

# Commercial Online Music Model Configuration (Optional)
# Options: 'mock' (default, offline PCM synthesis), 'suno', 'minimax', 'udio'
MUSIC_PROVIDER=mock
REAL_MUSIC_API_KEY=
REAL_MUSIC_BASE_URL=
SUNO_API_KEY=
SUNO_BASE_URL=https://api.suno.ai/v1
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
